# Salin file ini menjadi .env.local lalu isi nilainya.
# JANGAN commit file .env.local / secret asli ke repository.

# --- App ---
# Variabel berawalan NEXT_PUBLIC_ akan terlihat di browser. Jangan taruh secret di sini.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Database (PostgreSQL) ---
# Contoh lokal: postgresql://postgres:password@localhost:5432/begawan_dev?schema=public
DATABASE_URL=

# --- Auth.js ---
# Buat secret acak:  openssl rand -base64 32
AUTH_SECRET=
# Alamat lengkap website (wajib di production). Lokal: http://localhost:3000
AUTH_URL=http://localhost:3000

# --- Payment Gateway ---
# Gateway final belum dipilih. Pilihan saat ini:
#   mock     = simulasi pembayaran (HANYA berjalan di localhost) — default
#   midtrans = DRAFT/contoh integrasi (butuh akun sandbox Midtrans)
PAYMENT_PROVIDER=mock
# SECRET — jangan pernah diberi awalan NEXT_PUBLIC_ / di-commit.
MIDTRANS_SERVER_KEY=
# true HANYA setelah go-live disetujui. Selama development: false (sandbox).
MIDTRANS_IS_PRODUCTION=false

# --- Cron ---
# Token untuk /api/cron/expire-orders (membatalkan pesanan yang lewat batas bayar).
# Buat acak:  openssl rand -hex 32
CRON_SECRET=

# --- Testing (opsional, hanya untuk development) ---
# Database KHUSUS tes — isinya dihapus setiap kali `npm test` berjalan.
# Nama database wajib mengandung "test" dan berbeda dari DATABASE_URL.
TEST_DATABASE_URL=
# Akun admin untuk tes browser admin (npm run test:e2e). Kosongkan untuk melewati tes admin.
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
